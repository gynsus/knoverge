{
  "name": "@knoverge/db",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL schema, migrations, repositories and transactions",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrations/*": "./migrations/*"
  },
  "files": [
    "src",
    "migrations"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "migrations:generate": "drizzle-kit generate",
    "migrations:custom": "drizzle-kit generate --custom"
  },
  "dependencies": {
    "@knoverge/contracts": "workspace:*",
    "@knoverge/core": "workspace:*",
    "@knoverge/policy": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@knoverge/git-store": "workspace:*",
    "@knoverge/intelligence": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
