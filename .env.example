# Knoverge server configuration. Copy to .env for local development.
# All variables are prefixed with KNOVERGE_. See docs/DEPLOYMENT.md.

# HTTP listener. 127.0.0.1 is local trusted mode; set 0.0.0.0 only behind a reverse proxy or in a container.
KNOVERGE_PORT=3000
KNOVERGE_HOST=127.0.0.1

# Process role: all | web | worker
KNOVERGE_ROLE=all

# PostgreSQL connection (matches docker-compose.yml when running Postgres in Docker)
KNOVERGE_DATABASE_URL=postgres://knoverge:knoverge@localhost:5432/knoverge

# Directory for workspace Git repositories and attachments.
# A relative path resolves against the server process working directory (apps/server under `pnpm dev`).
KNOVERGE_DATA_DIR=./data

# Built web bundle to serve at /. Leave unset during development (Vite serves the app on :5173).
# KNOVERGE_WEB_DIST=./apps/web/dist

# Secrets. Generate each with `openssl rand -hex 32`. Keep them out of the database and back them up separately.
# KNOVERGE_LEDGER_KEY signs the event ledger; losing it makes historical verification impossible.
KNOVERGE_LEDGER_KEY=
# KNOVERGE_SESSION_SECRET signs browser cookies (CSRF).
KNOVERGE_SESSION_SECRET=
# KNOVERGE_TOKEN_PEPPER peppers agent credential hashes.
KNOVERGE_TOKEN_PEPPER=
# The server refuses to start without valid keys.

# Public URL of this installation. Cookies are marked Secure when it is https.
KNOVERGE_BASE_URL=http://localhost:3000

# Apply pending database migrations on start. Set to false and run `knoverge db migrate` yourself.
KNOVERGE_AUTO_MIGRATE=true

# Database password for the compose stack. Required: there is no default, so an
# installation cannot come up with a password anyone can guess.
KNOVERGE_POSTGRES_PASSWORD=

# Logging: fatal | error | warn | info | debug | trace
KNOVERGE_LOG_LEVEL=info

# Set to true only when running behind a trusted reverse proxy
KNOVERGE_TRUST_PROXY=false

# The Docker volumes holding the database and the workspace repositories.
# They are created by hand and declared external, so that `docker compose
# down -v` cannot remove them:
#
#     docker volume create knoverge-postgres
#     docker volume create knoverge-data
#
# Set these only to adopt volumes that already exist under other names — an
# installation from before they were external has them prefixed with the
# project name, as knoverge_knoverge-postgres and knoverge_knoverge-data.
# KNOVERGE_POSTGRES_VOLUME=knoverge-postgres
# KNOVERGE_DATA_VOLUME=knoverge-data
