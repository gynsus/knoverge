{
  "name": "@knoverge/server",
  "version": "0.0.0",
  "private": true,
  "description": "Knoverge server: HTTP API, MCP endpoint, web bundle and background worker",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "catalog:",
    "@fastify/csrf-protection": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@fastify/static": "catalog:",
    "@fastify/swagger": "catalog:",
    "@knoverge/auth": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@knoverge/contracts": "workspace:*",
    "@knoverge/core": "workspace:*",
    "@knoverge/db": "workspace:*",
    "@knoverge/git-store": "workspace:*",
    "@knoverge/policy": "workspace:*",
    "@node-rs/argon2": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "openapi-types": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/pg": "catalog:",
    "pino-pretty": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
